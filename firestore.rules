rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Nalozi kao zasebni dokumenti — isti vlasnik.
      match /accounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
